# Copy this file to ".env" in the repository root and edit it. ".env" is git-ignored.
# Placeholders only: never commit real keys. Anything not set here has a safe default.

# --- General -------------------------------------------------------------------------------
YTC_ENV=development                 # development | production (production disables /api/docs)
# YTC_DATA_DIR=                     # default: <repo>/data  (database, artifacts, backups, logs)
# YTC_DATABASE_URL=                 # default: SQLite file in the data dir. PostgreSQL later: postgresql+psycopg://...

# --- Network (localhost only by default; do not expose these ports to the internet) ----------
YTC_HOST=127.0.0.1
YTC_PORT=8000
# YTC_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# YTC_FRONTEND_ORIGIN=http://localhost:3000

# --- Sessions and abuse limits ----------------------------------------------------------------
# YTC_SESSION_TTL_HOURS=12
# YTC_COOKIE_SECURE=false           # set true only if you serve the dashboard over HTTPS
# YTC_LOGIN_MAX_FAILURES=5
# YTC_LOGIN_LOCKOUT_SECONDS=900
# YTC_API_RATE_LIMIT_PER_MINUTE=600

# --- Worker -------------------------------------------------------------------------------------
# YTC_WORKER_POLL_SECONDS=2
# YTC_TASK_LEASE_SECONDS=300
# YTC_TASK_MAX_ATTEMPTS=3
# YTC_TASK_BACKOFF_BASE_SECONDS=30
# YTC_MAX_CONCURRENT_TASKS=2
# YTC_BACKUP_RETENTION_COUNT=14

# --- Provider credentials (NOT used yet: each is wired in the phase noted) -----------------------
# You need your own key/grant for each. Subscriptions such as Claude Pro, ElevenLabs Pro and Canva Pro do not
# automatically include API access or commercial rights; check each plan's terms before enabling a provider.
# Phase 2+ : language model for agent reasoning
ANTHROPIC_API_KEY=
# Phase 2+ : narration (verify your plan's API access and commercial-use terms first)
ELEVENLABS_API_KEY=
# Phase 4  : YouTube OAuth client (Google Cloud console, "Desktop app"); never commit the downloaded JSON
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
